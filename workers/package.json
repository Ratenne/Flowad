{
  "name": "flowad-workers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.jsonc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-local.mjs",
    "build": "wrangler deploy --dry-run --outdir build",
    "db:local": "wrangler d1 migrations apply flowad --local --config wrangler.local.jsonc"
  },
  "dependencies": { "hono": "^4.0.0", "zod": "^4.0.0", "proj4": "^2.0.0" },
  "overrides": { "@typescript-eslint/typescript-estree": { "minimatch": "^11.0.8" } },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.0",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  }
}
