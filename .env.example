# Populate secrets only in Render or an untracked local environment.
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://ravirgo.com/flowad/api/tesla/callback
# Optional: navigation_request can use Fleet REST directly. Never disable TLS checks.
TESLA_COMMAND_PROXY_URL=
# An HTTPS OSRM driving service under your control; empty keeps estimate-only mode.
ROAD_ROUTING_URL=
# Set native ONLY behind a trusted ingress that overwrites forwarded headers.
SERVER_FORWARD_HEADERS_STRATEGY=none

# Base64 of at least 32 random bytes. Keep identical across backend replicas.
# Empty generates a process-only key; restart invalidates outstanding 5-minute tickets.
NAVIGATION_TICKET_SECRET=
